<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      Service-type-specific permissions (FOREGROUND_SERVICE_DATA_SYNC, _CAMERA, _CONNECTED_DEVICE,
      etc.) and the matching android:foregroundServiceType on the service below are injected by
      this package's config plugin (app.plugin.js) at `expo prebuild` time, based on the
      `serviceTypes` option consumers set in their app config. See the README.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Define custom permission for secure broadcast -->
    <permission
        android:name="${applicationId}.permission.FOREGROUND_SERVICE_BROADCAST"
        android:protectionLevel="signature" />

    <uses-permission android:name="${applicationId}.permission.FOREGROUND_SERVICE_BROADCAST" />

    <application>
        <meta-data
            android:name="expo.modules.foregroundservice.notification_channel_name"
            android:value="Put your app's channel name here ie. App Channel" />
        <meta-data
            android:name="expo.modules.foregroundservice.notification_channel_description"
            android:value="App is running in foreground" />

        <service
            android:name=".ForegroundTaskService"
            android:enabled="true"
            android:exported="false" />

        <service
            android:name=".HeadlessTaskRunner"
            android:enabled="true"
            android:exported="false" />
    </application>
</manifest>
